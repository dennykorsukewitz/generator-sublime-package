{
  "name": "generator-sublime-package",
  "version": "1.0.0",
  "description": "Sublime-Package is a Yeoman GENERATOR, which creates scaffolding for a Sublime-Packages.",
  "homepage": "https://github.com/dennykorsukewitz/generator-sublime-package",
  "author": {
    "name": "Denny Korsukéwitz",
    "email": "dennykorsukewitz@gmail.com",
    "url": "https://dennykorsukewitz.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennykorsukewitz/generator-sublime-package.git"
  },
  "license": "AGPL-3.0",
  "keywords": [
    "sublime",
    "sublime-text",
    "sublime-snippets",
    "sublime-command",
    "sublime-completion",
    "sublime-keymap",
    "sublime-macro",
    "sublime-menu",
    "sublime-mousemap",
    "sublime-plugin",
    "sublime-project",
    "sublime-readme",
    "sublime-setting",
    "sublime-snippet",
    "sublime-package",
    "yeoman",
    "yeoman-generator"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint-fix": "eslint . --fix && ejslint generators/",
    "ejslint": "ejslint generators/",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --colors",
    "coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --colors --verbose --forceExit --no-cache"
  },
  "files": [
    "generators",
    "src"
  ],
  "main": "generators/index.js",
  "dependencies": {
    "chalk": "^6.0.0",
    "change-case": "^5.4.4",
    "interpolate-json": "^3.0.0",
    "shelljs": "^0.10.0",
    "yeoman-generator": "^8.2.2",
    "yosay": "^3.0.0"
  },
  "devDependencies": {
    "@yeoman/adapter": "^4.0.2",
    "@yeoman/types": "^1.10.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^0.58.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.6.2",
    "yeoman-assert": "^3.1.1",
    "yeoman-environment": "^6.0.0",
    "yeoman-test": "^11.0.0"
  },
  "type": "module",
  "engines": {
    "npm": ">= 4.0.0",
    "node": ">=20.12.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ],
    "*.json": [
      "prettier --write",
      "git add"
    ]
  }
}
